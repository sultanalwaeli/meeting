<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ترشيح الطالب المثالي - مدرسة محمد بن سليمان الغافري</title>
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            background: linear-gradient(135deg, #e8f5e9 0%, #c8e6d9 100%);
            font-family: 'Tajawal', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            color: #1e3c2c;
        }
        .container {
            max-width: 800px;
            margin: 30px auto;
            background: white;
            border-radius: 32px;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, #1b5e20, #2e7d32);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 1.8rem;
        }
        .header .school-name {
            font-size: 0.9rem;
            opacity: 0.9;
            margin-top: 8px;
        }
        .content {
            padding: 30px;
        }
        .form-group {
            margin-bottom: 25px;
        }
        label {
            display: block;
            font-weight: 600;
            margin-bottom: 10px;
            color: #1b5e20;
        }
        select, textarea, input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 12px;
            border: 2px solid #e0e0e0;
            font-size: 1rem;
            font-family: inherit;
            transition: all 0.3s;
            background: #fafafa;
        }
        select:focus, textarea:focus, input:focus {
            border-color: #4caf50;
            outline: none;
            box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.1);
        }
        textarea {
            resize: vertical;
            min-height: 120px;
        }
        button {
            background: linear-gradient(135deg, #2e7d32, #1b5e20);
            color: white;
            border: none;
            padding: 15px;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: bold;
            width: 100%;
            cursor: pointer;
            transition: transform 0.2s;
        }
        button:hover:not(:disabled) {
            transform: translateY(-2px);
        }
        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .message {
            margin-top: 20px;
            padding: 15px;
            border-radius: 12px;
            text-align: center;
            font-weight: 500;
            display: none;
        }
        .success { background: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }
        .error { background: #ffebee; color: #c62828; border: 1px solid #ef9a9a; }
        .loading { background: #fff3e0; color: #e65100; border: 1px solid #ffb74d; }
        .stats {
            background: #f5f5f5;
            border-radius: 12px;
            padding: 15px;
            margin-top: 25px;
            text-align: center;
            font-size: 0.85rem;
            color: #666;
        }
        .student-count { font-size: 0.8rem; color: #666; margin-top: 5px; }
        .required-star { color: #f44336; margin-right: 4px; }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>⭐ ترشيح الطالب المثالي</h1>
        <div class="school-name">مدرسة محمد بن سليمان الغافري للتعليم الأساسي</div>
    </div>
    
    <div class="content">
        <form id="nominationForm">
            <div class="form-group">
                <label>👨‍🏫 البريد الإلكتروني للمعلم <span class="required-star">*</span></label>
                <input type="email" id="teacherEmail" placeholder="example@school.om" required>
            </div>

            <div class="form-group">
                <label>📚 اختيار الصف الدراسي <span class="required-star">*</span></label>
                <select id="classSelect" required disabled>
                    <option value="">-- جاري تحميل الصفوف --</option>
                </select>
            </div>

            <div class="form-group">
                <label>🏅 اختيار الطالب المرشح <span class="required-star">*</span></label>
                <select id="studentSelect" required disabled>
                    <option value="">-- اختر الصف أولاً --</option>
                </select>
                <div class="student-count" id="studentCount"></div>
            </div>

            <div class="form-group">
                <label>✍️ سبب الترشيح والتميز <span class="required-star">*</span></label>
                <textarea id="reason" placeholder="اذكر أسباب ترشيح هذا الطالب للقب الطالب المثالي..." required></textarea>
            </div>

            <button type="submit">🗳️ تأكيد الترشيح</button>
        </form>
        <div id="messageBox" class="message"></div>
        <div class="stats">
            💡 ملاحظات: يمكن لأكثر من معلم تزكية الطالب نفسه | جميع الترشيحات تسجل تلقائياً في قاعدة البيانات
        </div>
    </div>
</div>

<script>
    // =========================================================================
    // إعدادات الربط مع بياناتك (تم تحديثها بناءً على معلوماتك)
    // =========================================================================
    const SPREADSHEET_ID = '1VNYJ4_r6FmzJLrGlr0zK6-2OPZ62P-4DD1inWElW7HU'; // معرف جدول الطلاب والصفوف
    const SHEET_NAME = 'Level Up'; // اسم الورقة التي تحتوي على الصفوف والطلاب
    const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzIfsp2D5Sb1N4xloUe7oZkrq1FnLgAIqmQgQPeFu31UE0CKPsilSwWt9JusSr5rWTc/exec'; // رابط حفظ الترشيحات الجديدة

    // =========================================================================
    // جلب بيانات الطلاب والصفوف من جدول "Level Up"
    // =========================================================================
    async function loadStudentsData() {
        const classSelect = document.getElementById('classSelect');
        try {
            showMessage('⏳ جاري تحميل بيانات الطلاب...', 'loading');
            classSelect.disabled = true;
            
            // استخدام Google Visualization API لقراءة البيانات بشكل آمن
            const url = `https://docs.google.com/spreadsheets/d/${SPREADSHEET_ID}/gviz/tq?tqx=out:json&sheet=${SHEET_NAME}`;
            const response = await fetch(url);
            const text = await response.text();
            
            // تنظيف البيانات المستلمة
            const jsonText = text.substring(47, text.length - 2);
            const data = JSON.parse(jsonText);
            
            // تحويل البيانات إلى كائن studentsData { "الصف": ["طالب1", "طالب2"] }
            const studentsData = {};
            const rows = data.table.rows;
            
            for (let i = 0; i < rows.length; i++) {
                const row = rows[i].c;
                if (row && row[0] && row[0].v && row[1] && row[1].v) {
                    const className = row[0].v.toString().trim();
                    const studentName = row[1].v.toString().trim();
                    if (!studentsData[className]) studentsData[className] = [];
                    if (!studentsData[className].includes(studentName)) studentsData[className].push(studentName);
                }
            }
            
            // تحديث قائمة الصفوف في الواجهة
            updateClassSelect(studentsData);
            showMessage(`✅ تم تحميل ${Object.keys(studentsData).length} صف و ${Object.values(studentsData).flat().length} طالب`, 'success');
            
            // حفظ البيانات في كائن عام لاستخدامها لاحقاً
            window.studentsData = studentsData;
            
        } catch (error) {
            console.error('خطأ في التحميل:', error);
            showMessage('❌ فشل تحميل البيانات. تأكد من نشر جدول "Level Up" للعامة.', 'error');
            window.studentsData = {}; // بيانات فارغة لمنع الأخطاء
            classSelect.innerHTML = '<option value="">-- خطأ في التحميل --</option>';
        } finally {
            classSelect.disabled = false;
        }
    }
    
    // تحديث قائمة الصفوف في عنصر select
    function updateClassSelect(studentsData) {
        const classSelect = document.getElementById('classSelect');
        let options = '<option value="">-- اختر الصف --</option>';
        
        Object.keys(studentsData).sort().forEach(className => {
            options += `<option value="${className}">📖 ${className} (${studentsData[className].length} طالب)</option>`;
        });
        
        classSelect.innerHTML = options;
    }
    
    // عند اختيار صف، يتم عرض قائمة الطلاب الخاصة به
    function updateStudentsList() {
        const classSelect = document.getElementById('classSelect');
        const studentSelect = document.getElementById('studentSelect');
        const studentCountSpan = document.getElementById('studentCount');
        const selectedClass = classSelect.value;
        
        if (!selectedClass || !window.studentsData || !window.studentsData[selectedClass]) {
            studentSelect.disabled = true;
            studentSelect.innerHTML = '<option value="">-- اختر الصف أولاً --</option>';
            studentCountSpan.textContent = '';
            return;
        }
        
        const studentsList = window.studentsData[selectedClass];
        let options = '<option value="">-- اختر الطالب --</option>';
        studentsList.sort().forEach(student => {
            options += `<option value="${student}">👨‍🎓 ${student}</option>`;
        });
        
        studentSelect.innerHTML = options;
        studentSelect.disabled = false;
        studentCountSpan.textContent = `📊 عدد الطلاب في ${selectedClass}: ${studentsList.length} طالب`;
    }
    
    // =========================================================================
    // إرسال الترشيح إلى رابط Google Apps Script
    // =========================================================================
    async function submitNomination(teacherEmail, className, studentName, reason) {
        const response = await fetch(GOOGLE_SCRIPT_URL, {
            method: 'POST',
            mode: 'cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                teacherEmail: teacherEmail,
                className: className,
                studentName: studentName,
                reason: reason,
                timestamp: new Date().toLocaleString('ar-OM', { timeZone: 'Asia/Muscat' }),
                status: "قيد المراجعة"
            })
        });
        
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        const result = await response.json();
        if (result.result !== "success") throw new Error(result.message || "فشل الحفظ");
        return result;
    }
    
    // =========================================================================
    // وظائف مساعدة (عرض الرسائل، التحقق، تهيئة الصفحة)
    // =========================================================================
    function showMessage(message, type) {
        const msgDiv = document.getElementById('messageBox');
        msgDiv.textContent = message;
        msgDiv.className = `message ${type}`;
        msgDiv.style.display = 'block';
        setTimeout(() => msgDiv.style.display = 'none', 5000);
    }
    
    // تهيئة الصفحة عند التحميل
    document.addEventListener('DOMContentLoaded', () => {
        loadStudentsData(); // تحميل بيانات الطلاب والصفوف
        
        const classSelect = document.getElementById('classSelect');
        const studentSelect = document.getElementById('studentSelect');
        const form = document.getElementById('nominationForm');
        
        classSelect.addEventListener('change', updateStudentsList);
        
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const teacherEmail = document.getElementById('teacherEmail').value.trim();
            const className = classSelect.value;
            const studentName = studentSelect.value;
            const reason = document.getElementById('reason').value.trim();
            
            if (!teacherEmail || !teacherEmail.includes('@')) return showMessage('يرجى إدخال بريد إلكتروني صحيح', 'error');
            if (!className) return showMessage('يرجى اختيار الصف', 'error');
            if (!studentName) return showMessage('يرجى اختيار الطالب', 'error');
            if (reason.length < 10) return showMessage('يرجى كتابة سبب الترشيح (10 أحرف على الأقل)', 'error');
            
            const submitBtn = form.querySelector('button');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '⏳ جاري الإرسال...';
            
            try {
                await submitNomination(teacherEmail, className, studentName, reason);
                showMessage(`✅ تم ترشيح ${studentName} بنجاح!`, 'success');
                form.reset();
                classSelect.value = '';
                updateStudentsList(); // إعادة تعيين قائمة الطلاب
            } catch (error) {
                console.error(error);
                showMessage('❌ فشل الإرسال: ' + error.message, 'error');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        });
    });
</script>
</body>
</html>
